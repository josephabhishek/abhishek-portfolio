# Contact form email delivery (server-side, via Resend — https://resend.com)
# 1. Create a free Resend account and an API key.
# 2. (Recommended) Verify your domain in Resend so you can send from your own address.
RESEND_API_KEY=re_your_api_key_here

# Where enquiries are delivered (your inbox).
CONTACT_TO_EMAIL=you@yourdomain.com

# The "from" address. Must be on a domain verified in Resend.
# If you leave this unset, it falls back to Resend's shared sandbox sender (fine for testing).
CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>
